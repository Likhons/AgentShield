# Copy this file to .env and fill in your own values.
# Never commit .env (it is in .gitignore).

# Which LLM provider to use: mock | gemini | groq
# "mock" needs no key and works offline (used for tests and demo safety).
LLM_PROVIDER=mock

# Model name for the chosen provider. Look up the current free-tier model:
#   Gemini: https://ai.google.dev/gemini-api/docs/models
#   Groq:   https://console.groq.com/docs/models
LLM_MODEL=your-model-name-here

# Optional: a different model for AgentShield's intent judge (same provider).
# Groq rate limits are per model, so a separate judge model avoids waiting
# when the agent and the judge share one model. Empty = use LLM_MODEL.
JUDGE_MODEL=

# API keys (only the one for your provider is needed)
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here

# HTTP gateway (agentshield/api): if set, every /v1 request must send this value
# in the X-API-Key header. Set it whenever the gateway is reachable from other machines.
AGENTSHIELD_API_KEY=

# Where the audit log is stored
AUDIT_DB_PATH=agentshield_audit.db
